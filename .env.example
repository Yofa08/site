# ── Deal Manager Configuration ───────────────────────────
# Copy this file to .env and edit as needed.

# Environment: dev (auto-reload) or prod (no reload)
ENV=dev

# Server
HOST=0.0.0.0
PORT=8000

# Database (leave empty for default SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/dealmanager
# For MySQL: mysql+pymysql://user:password@localhost:3306/dealmanager
# DATABASE_URL=

# Site defaults (can be changed in Admin → Settings later)
SITE_TITLE=Daily Deals
SITE_TAGLINE=Best Amazon Deals — Updated Every Day
GOOGLE_SHEET_URL=
SUBSCRIBE_URL=
