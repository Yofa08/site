[Unit]
Description=Deal Manager — Amazon Deals Platform
After=network.target

[Service]
Type=simple
User=administrator
WorkingDirectory=/opt/deal-manager
Environment=ENV=prod
Environment=HOST=0.0.0.0
Environment=PORT=8000
ExecStart=/opt/deal-manager/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
